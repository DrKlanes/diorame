{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": false,
    // Sprint de TS: las 8 flags de "strict" medidas una a una, activadas por
    // separado en vez de poner "strict": true de golpe. Las 6 de abajo dan 0
    // errores. Solo DOS quedan fuera, y ninguna por olvido:
    //   · strictFunctionTypes — 1 error, y es un desacople deliberado y
    //     documentado en exportHandlers.ts (AnimationRecordOptions.dispatch).
    //     Decisión de arquitectura, no fix mecánico: activarla obligaría a
    //     reacoplar algo que se desacopló a propósito.
    //   · strictPropertyInitialization — exige strictNullChecks para siquiera
    //     evaluarse (TS5052), así que desde v3.17.12 ya SÍ se podría activar.
    //     Sigue sin hacer nada: este codebase no tiene ni una sola clase. No es
    //     deuda pendiente, es estructuralmente inaplicable.
    // Con esto el sprint queda cerrado: lo que falta es una decisión tomada y una
    // imposibilidad estructural, no trabajo pendiente.
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    // Activada en v3.17.12, después de que v3.17.11 dejara GestureState con sus
    // campos requeridos. Ese era el cluster entero: 10 errores, todos lecturas de
    // estado de gesto táctil en StrataCanvas que el runtime nunca producía como
    // undefined. Se arregló el modelo, no las lecturas — ni un solo `?? 0`.
    "strictNullChecks": true,
    // Activada en v3.17.13. Su único error era TS7016 por 'gifenc', que no trae
    // typings ni tiene @types en npm: resuelto con src/types/gifenc.d.ts, escrito
    // leyendo las firmas del propio paquete y declarando SOLO lo que gifHandler.ts
    // usa. Un `declare module 'gifenc';` a secas habría callado el error dejando
    // todo en any — el mismo agujero, más silencioso.
    "noImplicitAny": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "sonner@2.0.3": ["./node_modules/sonner"],
      "class-variance-authority@0.7.1": ["./node_modules/class-variance-authority"],
      "@radix-ui/react-tooltip@1.1.8": ["./node_modules/@radix-ui/react-tooltip"],
      "@radix-ui/react-slot@1.1.2": ["./node_modules/@radix-ui/react-slot"],
      "figma:asset/texture-paper.png": ["./src/assets/texture-paper.png"],
      "figma:asset/texture-grunge.png": ["./src/assets/texture-grunge.png"],
      "figma:asset/logo-symbol.png": ["./src/assets/logo-symbol.png"]
    }
  },
  "include": ["src", "tools", "tests"]
}
