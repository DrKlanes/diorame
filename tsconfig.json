      "figma:asset/texture-paper.png": ["./src/assets/texture-paper.png"],
      "figma:asset/texture-grunge.png": ["./src/assets/texture-grunge.png"],
      "figma:asset/logo-symbol.png": ["./src/assets/logo-symbol.png"]
    }
  },
  "include": ["src"]
}
